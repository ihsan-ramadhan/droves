# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.vscode/

# Platform build output
/android/app/debug
/android/app/profile
/android/app/release
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh

# OS
.DS_Store

# golden renders are generated output (flutter test --update-goldens); CI does
# not pixel-compare, so they stay out of the repo
/test/goldens/

# Compiled bridge binary; rebuilt from source.
/bridge/bridge

# golden-test failure diffs are throwaway output
/test/failures/

# Local secrets and environment files never belong in the repo.
.env
.env.*
*.pem

# Upload keystore for release signing; CI restores it from secrets.
*.jks
*.keystore
/android/key.properties
